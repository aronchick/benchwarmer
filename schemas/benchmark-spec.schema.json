{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchwarmer benchmark specification",
  "oneOf": [{ "$ref": "#/$defs/series" }, { "$ref": "#/$defs/matrix" }],
  "$defs": {
    "receipts": {
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string" },
        "higherIsBetter": { "type": "boolean", "default": true },
        "source": { "type": "string" },
        "caveat": { "type": "string" },
        "interpretation": { "type": "string" }
      },
      "required": ["title", "metric"]
    },
    "series": {
      "allOf": [
        { "$ref": "#/$defs/receipts" },
        {
          "type": "object",
          "required": ["series"],
          "properties": {
            "kind": { "const": "series" },
            "series": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "value": { "type": "number" },
                  "note": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "matrix": {
      "allOf": [
        { "$ref": "#/$defs/receipts" },
        {
          "type": "object",
          "required": ["kind", "columns", "rows"],
          "properties": {
            "kind": { "const": "matrix" },
            "sourceHighlight": { "type": "string" },
            "columns": {
              "type": "array",
              "minItems": 2,
              "items": { "type": "string", "minLength": 1 }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["label", "values"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "detail": { "type": "string" },
                  "group": { "type": "string" },
                  "higherIsBetter": { "type": "boolean" },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "type": ["number", "null"] }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
