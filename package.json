{
  "name": "benchwarmer",
  "version": "0.2.0",
  "private": false,
  "description": "Rehabilitate benchmark charts into auditable, decision-first layouts.",
  "type": "module",
  "bin": {
    "benchwarmer": "./bin/benchwarmer.mjs"
  },
  "scripts": {
    "test": "node --test",
    "test:integration": "RUN_LIVE_INTEGRATION=1 node --test --test-concurrency=1 test/live-extraction.test.mjs",
    "check": "node --check app.js && node --check lib/benchmark.mjs && node --check bin/benchwarmer.mjs && node --check worker.js",
    "verify": "npm run check && npm test && npm run deploy:dry",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "example:image": "node scripts/render-matrix-svg.mjs examples/chart-crime.json examples/chart-crime-corrected.svg"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260811.1": true
  }
}
